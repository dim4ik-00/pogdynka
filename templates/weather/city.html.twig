{% extends 'base.html.twig' %}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main class="container mt-4">
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <table class="table table-striped table-bordered mt-3">
            <thead>
            <tr>
                <th>Data</th>
                <th>Temperature</th>
                <th>Humidity</th>
                <th>Pressure</th>
                <th>Wind speed</th>
            </tr>
            </thead>
            <tbody>
            {% for measurement in measurements %}
                <tr>
                    <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                    <td>{{ measurement.celsius }} &deg;C</td>
                    <td>{{ measurement.humidity ?? '-' }} %</td>
                    <td>{{ measurement.pressure ?? '-' }} hPa</td>
                    <td>{{ measurement.windSpeed ?? '-' }} m/s</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Brak pomiarów</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </main>
{% endblock %}
